# Copy to .env and fill in. Nothing here is baked into the code.
ANTHROPIC_API_KEY=

# Which scenario pack to serve. Must match a directory under scenarios/.
SCENARIO=airport

# Model + reasoning depth. See docs/LATENCY.md for why these defaults.
MODEL=claude-opus-5
EFFORT=low
MAX_TOKENS=8192

# Streaming is the whole point; set to false only to measure the difference.
STREAMING=true

# Abuse / cost guard. Canned scenario replays never count against these.
RATE_LIMIT_PER_MIN=30
RATE_LIMIT_DAILY=1000
